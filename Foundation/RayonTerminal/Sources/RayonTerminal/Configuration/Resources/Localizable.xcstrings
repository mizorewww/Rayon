    "%lld of Ghostty's shortcuts are for windows, tabs and splits, which Rayon manages itself; they are not shown." : {
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld of Ghostty's shortcuts is for windows, tabs and splits, which Rayon manages itself; it is not shown."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld of Ghostty's shortcuts are for windows, tabs and splits, which Rayon manages itself; they are not shown."
                }
              }
            }
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ghostty 有 %lld 个快捷键用于窗口、标签页和分屏，这些由 Rayon 自行管理，因此不显示。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ghostty 有 %lld 個快捷鍵用於視窗、標籤頁和分屏，這些由 Rayon 自行管理，因此不顯示。"
          }
        },
        "ja" : {
          "variations" : {
            "plural" : {
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Ghostty のショートカットのうち %lld 件は、Rayon が独自に管理するウインドウ、タブ、分割用のため表示されません。"
                }
              }
            }
          }
        },
        "fr" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld raccourci de Ghostty concerne les fenêtres, onglets et divisions, que Rayon gère lui-même ; il n’est pas affiché."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld raccourcis de Ghostty concernent les fenêtres, onglets et divisions, que Rayon gère lui-même ; ils ne sont pas affichés."
                }
              }
            }
          }
        },
        "es" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld de los atajos de Ghostty es para ventanas, pestañas y divisiones, que Rayon gestiona por sí mismo; no se muestra."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld de los atajos de Ghostty son para ventanas, pestañas y divisiones, que Rayon gestiona por sí mismo; no se muestran."
                }
              }
            }
          }
        }
      }
    },
