    "%@ uses the same keys and is set later, so it wins." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 使用相同的按键且设置在后，因此以它为准。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 使用相同的按鍵且設定在後，因此以它為準。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ は同じキーを使い、後で設定されているため、こちらが優先されます。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ utilise les mêmes touches et est défini plus tard : il l’emporte."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ usa las mismas teclas y se define después, así que prevalece."
          }
        }
      }
    },
