    "Option sends Alt sequences to programs instead of typing special characters. By default this follows the keyboard layout." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Option 向程序发送 Alt 序列，而不是输入特殊字符。默认跟随键盘布局。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Option 向程式傳送 Alt 序列，而不是輸入特殊字元。預設跟隨鍵盤配置。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Option キーで特殊文字を入力する代わりに、Alt シーケンスをプログラムに送信します。デフォルトではキーボードレイアウトに従います。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Option envoie des séquences Alt aux programmes au lieu de taper des caractères spéciaux. Par défaut, suit la disposition du clavier."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Option envía secuencias Alt a los programas en lugar de escribir caracteres especiales. Por omisión sigue la distribución del teclado."
          }
        }
      }
    },
    "Option-click at a prompt to move the cursor there." : {
