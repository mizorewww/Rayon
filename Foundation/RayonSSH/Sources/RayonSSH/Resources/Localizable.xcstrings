          "stringUnit" : {
            "state" : "translated",
            "value" : "不是 SOCKS5 CONNECT 請求。"
          }
        }
      }
    },
    "PEM keys encrypted with %@ are not supported." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不支持使用 %@ 加密的 PEM 密钥。"
