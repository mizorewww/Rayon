        }
      }
    },
    "%@ keys are not supported. Use an Ed25519, ECDSA or RSA key." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不支持 %@ 密钥。请使用 Ed25519、ECDSA 或 RSA 密钥。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不支援 %@ 金鑰。請使用 Ed25519、ECDSA 或 RSA 金鑰。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 鍵には対応していません。Ed25519、ECDSA、または RSA 鍵を使用してください。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les clés %@ ne sont pas prises en charge. Utilisez une clé Ed25519, ECDSA ou RSA."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las claves %@ no son compatibles. Usa una clave Ed25519, ECDSA o RSA."
          }
        }
      }
    },
    "Could not listen on port %lld (%@)." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Could not listen on port %1$lld (%2$@)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法监听端口 %lld（%@）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法監聽埠 %lld（%@）。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ポート %1$lld で待ち受けできませんでした（%2$@）。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible d’écouter sur le port %1$lld (%2$@)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido escuchar en el puerto %1$lld (%2$@)."
          }
        }
      }
    },
    "Could not open a socket for the SSH agent." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法为 SSH 代理打开套接字。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法為 SSH 代理開啟套接字。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH エージェント用のソケットを開けませんでした。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible d’ouvrir un socket pour l’agent SSH."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido abrir un socket para el agente SSH."
          }
        }
      }
    },
    "Could not reach the SSH agent at %@ (%@)." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Could not reach the SSH agent at %1$@ (%2$@)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法访问位于 %@ 的 SSH 代理（%@）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法訪問位於 %@ 的 SSH 代理（%@）。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ の SSH エージェントに接続できませんでした（%2$@）。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de joindre l’agent SSH à %1$@ (%2$@)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido acceder al agente SSH en %1$@ (%2$@)."
          }
        }
      }
    },
    "DSA keys are not supported. Use an Ed25519, ECDSA or RSA key." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不支持 DSA 密钥。请使用 Ed25519、ECDSA 或 RSA 密钥。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不支援 DSA 金鑰。請使用 Ed25519、ECDSA 或 RSA 金鑰。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DSA 鍵には対応していません。Ed25519、ECDSA、または RSA 鍵を使用してください。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les clés DSA ne sont pas prises en charge. Utilisez une clé Ed25519, ECDSA ou RSA."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las claves DSA no son compatibles. Usa una clave Ed25519, ECDSA o RSA."
          }
        }
      }
    },
    "Encrypted PKCS#8 keys are not supported. Convert the key with `ssh-keygen -p -f <key>`, which writes OpenSSH format." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不支持加密的 PKCS#8 密钥。请使用 `ssh-keygen -p -f <key>` 将密钥转换为 OpenSSH 格式。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不支援加密的 PKCS#8 金鑰。請使用 `ssh-keygen -p -f <key>` 將金鑰轉換為 OpenSSH 格式。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暗号化された PKCS#8 鍵には対応していません。`ssh-keygen -p -f <key>` で鍵を OpenSSH 形式に変換してください。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les clés PKCS#8 chiffrées ne sont pas prises en charge. Convertissez la clé avec `ssh-keygen -p -f <key>`, qui écrit au format OpenSSH."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las claves PKCS#8 cifradas no son compatibles. Convierte la clave con `ssh-keygen -p -f <key>`, que la escribe en formato OpenSSH."
          }
        }
      }
    },
    "Keys encrypted with %@ are not supported. Re-encrypt it with `ssh-keygen -p -Z aes256-ctr -f <key>`." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不支持使用 %@ 加密的密钥。请使用 `ssh-keygen -p -Z aes256-ctr -f <key>` 重新加密。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不支援使用 %@ 加密的金鑰。請使用 `ssh-keygen -p -Z aes256-ctr -f <key>` 重新加密。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ で暗号化された鍵には対応していません。`ssh-keygen -p -Z aes256-ctr -f <key>` で再暗号化してください。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les clés chiffrées avec %@ ne sont pas prises en charge. Rechiffrez-la avec `ssh-keygen -p -Z aes256-ctr -f <key>`."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las claves cifradas con %@ no son compatibles. Vuelve a cifrarla con `ssh-keygen -p -Z aes256-ctr -f <key>`."
          }
        }
      }
    },
