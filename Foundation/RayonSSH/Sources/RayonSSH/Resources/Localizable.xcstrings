        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沒有可用於連線 %@ 的 WebSocket 的事件迴圈。"
          }
        }
      }
    },
    "Not a SOCKS5 CONNECT request." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不是 SOCKS5 CONNECT 请求。"
          }
        },
