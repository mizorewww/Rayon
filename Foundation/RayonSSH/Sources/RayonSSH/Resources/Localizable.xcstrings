              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%@ is more than %lld folder deep."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%@ is more than %lld folders deep."
                }
              }
            }
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 的层级超过 %lld 层文件夹。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 的層級超過 %lld 層資料夾。"
          }
        },
        "ja" : {
          "variations" : {
            "plural" : {
              "other" : {
