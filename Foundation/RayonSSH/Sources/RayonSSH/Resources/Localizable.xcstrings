{
  "sourceLanguage" : "en",
  "strings" : {
    "\"%@\" is not a private key Rayon can read." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”不是 Rayon 能读取的私钥。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”不是 Rayon 能讀取的私鑰。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」は Rayon が読み取れる秘密鍵ではありません。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » n’est pas une clé privée lisible par Rayon."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" no es una clave privada que Rayon pueda leer."
          }
        }
      }
    },
    "\"%@\" is not an SSH agent socket." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”不是 SSH 代理套接字。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”不是 SSH 代理套接字。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」は SSH エージェントのソケットではありません。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » n’est pas un socket d’agent SSH."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" no es un socket de agente SSH."
          }
        }
      }
    },
    "%@ did not answer the WebSocket upgrade in time." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 未及时响应 WebSocket 升级。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 未及時回應 WebSocket 升級。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ が WebSocket のアップグレードに時間内に応答しませんでした。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ n’a pas répondu à temps à la mise à niveau WebSocket."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no ha respondido a tiempo a la actualización a WebSocket."
          }
        }
      }
    },
    "%@ is more than %lld folders deep." : {
      "localizations" : {
        "en" : {
          "variations" : {
