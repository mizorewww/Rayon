{
  "sourceLanguage" : "en",
  "strings" : {
    "\"%@\" is not a private key Rayon can read." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”不是 Rayon 能读取的私钥。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”不是 Rayon 能讀取的私鑰。"
          }
        }
      }
    },
    "\"%@\" is not an SSH agent socket." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”不是 SSH 代理套接字。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”不是 SSH 代理套接字。"
          }
        }
      }
    },
    "%@ did not answer the WebSocket upgrade in time." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 未及时响应 WebSocket 升级。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 未及時回應 WebSocket 升級。"
          }
        }
      }
    },
    "%@ is more than %lld folders deep." : {
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%@ is more than %lld folder deep."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%@ is more than %lld folders deep."
                }
              }
            }
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 的层级超过 %lld 层文件夹。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 的層級超過 %lld 層資料夾。"
          }
        }
      }
    },
    "%@ keys are not supported. Use an Ed25519, ECDSA or RSA key." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不支持 %@ 密钥。请使用 Ed25519、ECDSA 或 RSA 密钥。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不支援 %@ 金鑰。請使用 Ed25519、ECDSA 或 RSA 金鑰。"
          }
        }
      }
    },
    "Could not listen on port %lld (%@)." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Could not listen on port %1$lld (%2$@)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法监听端口 %lld（%@）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法監聽埠 %lld（%@）。"
          }
        }
      }
    },
    "Could not open a socket for the SSH agent." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法为 SSH 代理打开套接字。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法為 SSH 代理開啟套接字。"
          }
        }
      }
    },
    "Could not reach the SSH agent at %@ (%@)." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Could not reach the SSH agent at %1$@ (%2$@)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法访问位于 %@ 的 SSH 代理（%@）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法訪問位於 %@ 的 SSH 代理（%@）。"
          }
        }
      }
    },
    "DSA keys are not supported. Use an Ed25519, ECDSA or RSA key." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不支持 DSA 密钥。请使用 Ed25519、ECDSA 或 RSA 密钥。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不支援 DSA 金鑰。請使用 Ed25519、ECDSA 或 RSA 金鑰。"
          }
        }
      }
    },
    "Encrypted PKCS#8 keys are not supported. Convert the key with `ssh-keygen -p -f <key>`, which writes OpenSSH format." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不支持加密的 PKCS#8 密钥。请使用 `ssh-keygen -p -f <key>` 将密钥转换为 OpenSSH 格式。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不支援加密的 PKCS#8 金鑰。請使用 `ssh-keygen -p -f <key>` 將金鑰轉換為 OpenSSH 格式。"
          }
        }
      }
    },
    "Keys encrypted with %@ are not supported. Re-encrypt it with `ssh-keygen -p -Z aes256-ctr -f <key>`." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不支持使用 %@ 加密的密钥。请使用 `ssh-keygen -p -Z aes256-ctr -f <key>` 重新加密。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不支援使用 %@ 加密的金鑰。請使用 `ssh-keygen -p -Z aes256-ctr -f <key>` 重新加密。"
          }
        }
      }
    },
    "Malformed RSA public key." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RSA 公钥格式错误。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RSA 公鑰格式錯誤。"
