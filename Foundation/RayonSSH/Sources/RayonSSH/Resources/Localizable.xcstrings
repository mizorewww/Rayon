    "The PEM key could not be read. Rayon reads RSA and ECDSA keys in PEM." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法读取 PEM 密钥。Rayon 可读取 PEM 格式的 RSA 和 ECDSA 密钥。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法讀取 PEM 金鑰。Rayon 可讀取 PEM 格式的 RSA 和 ECDSA 金鑰。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PEM 鍵を読み取れませんでした。Rayon は PEM 形式の RSA および ECDSA 鍵を読み取れます。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La clé PEM n’a pas pu être lue. Rayon lit les clés RSA et ECDSA au format PEM."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido leer la clave PEM. Rayon lee claves RSA y ECDSA en PEM."
          }
        }
      }
    },
    "The SSH agent did not list its keys." : {
      "localizations" : {
        "zh-Hans" : {
