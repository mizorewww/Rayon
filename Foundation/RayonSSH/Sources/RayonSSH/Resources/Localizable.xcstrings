          "stringUnit" : {
            "state" : "translated",
            "value" : "RSA 簽名格式錯誤。"
          }
        }
      }
    },
    "No event loop for the WebSocket to %@." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有可用于连接 %@ 的 WebSocket 的事件循环。"
