    },
    "The server's host key has changed. Saved: %@ %@. Offered: %@ %@. If the server was reinstalled or its keys were replaced, forget its host key and connect again. If not, something may be intercepting the connection." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The server's host key has changed. Saved: %1$@ %2$@. Offered: %3$@ %4$@. If the server was reinstalled or its keys were replaced, forget its host key and connect again. If not, something may be intercepting the connection."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "服务器的主机密钥已更改。已存储：%@ %@。出示：%@ %@。如果服务器已重装或其密钥已更换，请忘记其主机密钥后重新连接。否则，可能有东西正在拦截连接。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "伺服器的主機金鑰已更改。已儲存：%@ %@。出示：%@ %@。如果伺服器已重灌或其金鑰已更換，請忘記其主機金鑰後重新連線。否則，可能有東西正在攔截連線。"
          }
        }
      }
