    "The VNC server asks for a password. Set one on the server, or on the identity it falls back to." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VNC 服务器要求提供密码。请在服务器或其备用身份上设置密码。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VNC 伺服器要求提供密碼。請在伺服器或其備用身份上設定密碼。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VNC サーバがパスワードを求めています。サーバ、または代わりに使われる認証情報にパスワードを設定してください。"
          }
        },
        "fr" : {
          "stringUnit" : {
