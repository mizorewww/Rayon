    "The clipboard syncs itself while connected; these push and pull by hand" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "连接期间剪贴板会自动同步；这些选项用于手动推送和拉取"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "連線期間剪貼簿會自動同步；這些選項用於手動推送和拉取"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クリップボードは接続中に自動で同期されます。これらは手動で送信・取得します"
          }
        },
        "fr" : {
          "stringUnit" : {
