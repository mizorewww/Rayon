    "%@ is not available in this build." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no está disponible en esta compilación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ n’est pas disponible dans cette build."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ はこのビルドでは利用できません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此版本中不可用 %@。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此版本中不可用 %@。"
          }
        }
      }
    },
    "%@ is protected by Cloudflare Access and asks to sign in. Add a service token to the server (Edit Server › Cloudflare Access): signing in with a browser is not supported yet." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ está protegido por Cloudflare Access y pide iniciar sesión. Añade un token de servicio al servidor (Editar servidor › Cloudflare Access): todavía no se puede iniciar sesión con un navegador."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est protégé par Cloudflare Access et demande une connexion. Ajoutez un jeton de service au serveur (Modifier le serveur › Cloudflare Access) : la connexion par navigateur n’est pas encore prise en charge."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ は Cloudflare Access で保護されており、サインインを求めています。サーバにサービストークンを追加してください（サーバを編集 › Cloudflare Access）。ブラウザでのサインインにはまだ対応していません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 受 Cloudflare Access 保护，要求登录。请为服务器添加服务令牌（编辑服务器 › Cloudflare Access）：目前尚不支持通过浏览器登录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 受 Cloudflare Access 保護，要求登入。請為伺服器新增服務令牌（編輯伺服器 › Cloudflare Access）：目前尚不支援通過瀏覽器登入。"
          }
        }
      }
    },
    "%@ presented a different host key than the one saved for it. Someone may be intercepting the connection. Only replace the saved key if you know the server was reinstalled or its keys were changed." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ha presentado una clave de host distinta de la guardada. Alguien podría estar interceptando la conexión. Reemplaza la clave guardada solo si sabes que el servidor se ha reinstalado o que sus claves han cambiado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ a présenté une clé d’hôte différente de celle enregistrée. Quelqu’un intercepte peut-être la connexion. Ne remplacez la clé enregistrée que si vous savez que le serveur a été réinstallé ou ses clés changées."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ が保存済みのものとは異なるホスト鍵を提示しました。接続が傍受されている可能性があります。サーバが再インストールされたか鍵が変更されたことが確実な場合にのみ、保存済みの鍵を置き換えてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 出示的主机密钥与已存储的不同，可能有人正在拦截连接。只有在你确定服务器已重装或其密钥已更换时，才替换已存储的密钥。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 出示的主機金鑰與已儲存的不同，可能有人正在攔截連線。只有在你確定伺服器已重灌或其金鑰已更換時，才替換已儲存的金鑰。"
          }
        }
      }
    },
