    },
    "The server sent unusable Apple authentication key parameters." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "服务器发送的 Apple 认证密钥参数不可用。"
          }
        },
        "zh-Hant" : {
