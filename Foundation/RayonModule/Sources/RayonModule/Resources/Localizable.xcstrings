            "value" : "El servidor ha enviado una longitud de clave de autenticación de Apple no utilizable (%lld)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur a envoyé une longueur de clé d’authentification Apple inutilisable (%lld)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバから使用できない Apple 認証の鍵長が送られました（%lld）。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "服务器发送的 Apple 认证密钥长度不可用（%lld）。"
