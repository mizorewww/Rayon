          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバから使用できない Apple 認証の鍵パラメータが送られました。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
