            "value" : "サーバからこのクライアントが読み取れないデータが送られました（%@）。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur a envoyé des données que ce client ne peut pas lire (%@)."
          }
        },
        "es" : {
          "stringUnit" : {
