    "Cloudflare Access did not accept the service token for %@. Check its Client ID and Secret, and that the application's policy allows it (Service Auth)." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cloudflare Access 未接受 %@ 的服务令牌。请检查其 Client ID 和 Secret，并确认应用的策略允许它（Service Auth）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cloudflare Access 未接受 %@ 的服務令牌。請檢查其 Client ID 和 Secret，並確認應用的策略允許它（Service Auth）。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cloudflare Access は %@ のサービストークンを受け付けませんでした。Client ID と Secret、およびアプリケーションのポリシーで許可されているか（Service Auth）を確認してください。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cloudflare Access n’a pas accepté le jeton de service de %@. Vérifiez son Client ID et son Secret, et que la règle de l’application l’autorise (Service Auth)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cloudflare Access no ha aceptado el token de servicio de %@. Comprueba su Client ID y Secret, y que la política de la aplicación lo permita (Service Auth)."
          }
        }
      }
    },
