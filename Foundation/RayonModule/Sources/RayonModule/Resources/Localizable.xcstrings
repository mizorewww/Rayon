    "Drag to move the pointer · tap to click · two fingers to scroll or right-click · three fingers for the keyboard" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra para mover el puntero · toca para hacer clic · dos dedos para desplazarte o hacer clic derecho · tres dedos para el teclado"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
