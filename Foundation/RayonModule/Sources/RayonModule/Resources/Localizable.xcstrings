        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor ha enviado parámetros de clave de autenticación de Apple no utilizables."
          }
        }
      }
    },
    "The servers, identities and snippets saved by the previous version of Rayon could not be opened (%@). They are kept as they are, and Rayon tries again on its next launch." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法打开旧版 Rayon 存储的服务器、身份和代码片段（%@）。它们会原样保留，Rayon 将在下次启动时重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法開啟舊版 Rayon 儲存的伺服器、身份和程式碼片段（%@）。它們會原樣保留，Rayon 將在下次啟動時重試。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以前のバージョンの Rayon が保存したサーバ、認証情報、スニペットを開けませんでした（%@）。これらはそのまま保持され、次回起動時に再試行します。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les serveurs, identités et extraits enregistrés par la version précédente de Rayon n’ont pas pu être ouverts (%@). Ils sont conservés tels quels, et Rayon réessaiera au prochain lancement."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se han podido abrir los servidores, identidades y fragmentos guardados por la versión anterior de Rayon (%@). Se conservan tal cual y Rayon lo volverá a intentar en el próximo inicio."
          }
        }
      }
    },
    "The servers, identities and snippets saved by the previous version of Rayon could not be opened: the key that protects them could not be read from the keychain. They are kept as they are, and Rayon tries again on its next launch." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法打开旧版 Rayon 存储的服务器、身份和代码片段：无法从钥匙串读取保护它们的密钥。它们会原样保留，Rayon 将在下次启动时重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法開啟舊版 Rayon 儲存的伺服器、身份和程式碼片段：無法從鑰匙串讀取保護它們的金鑰。它們會原樣保留，Rayon 將在下次啟動時重試。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以前のバージョンの Rayon が保存したサーバ、認証情報、スニペットを開けませんでした。保護する鍵をキーチェーンから読み取れませんでした。これらはそのまま保持され、次回起動時に再試行します。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les serveurs, identités et extraits enregistrés par la version précédente de Rayon n’ont pas pu être ouverts : la clé qui les protège n’a pas pu être lue depuis le trousseau. Ils sont conservés tels quels, et Rayon réessaiera au prochain lancement."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se han podido abrir los servidores, identidades y fragmentos guardados por la versión anterior de Rayon: no se ha podido leer del llavero la clave que los protege. Se conservan tal cual y Rayon lo volverá a intentar en el próximo inicio."
          }
        }
      }
    },
    "The shell ended (%@)." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shell 已结束（%@）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shell 已結束（%@）。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "シェルが終了しました（%@）。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le shell s’est terminé (%@)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La shell ha finalizado (%@)."
          }
        }
      }
    },
    "There is no SSH agent on iOS. Give the identity its private key instead." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS 上没有 SSH 代理。请改为给身份提供私钥。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS 上沒有 SSH 代理。請改為給身份提供私鑰。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS には SSH エージェントがありません。代わりに認証情報に秘密鍵を設定してください。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il n’y a pas d’agent SSH sur iOS. Donnez plutôt sa clé privée à l’identité."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En iOS no hay agente SSH. Dale a la identidad su clave privada."
          }
        }
      }
    },
    "They are servers in the \"%@\" folder, kept up to date with the account." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
