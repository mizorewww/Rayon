    "%@ did not accept a connection to port %u through UU Remote (%@). Turn on SSH on the device (on a Mac: System Settings › General › Sharing › Remote Login)." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ did not accept a connection to port %2$u through UU Remote (%3$@). Turn on SSH on the device (on a Mac: System Settings › General › Sharing › Remote Login)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 未接受通过 UU 远程连接到端口 %u（%@）。请在该设备上开启 SSH（Mac 上：系统设置 › 通用 › 共享 › 远程登录）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 未接受通過 UU 遠端連線到埠 %u（%@）。請在該裝置上開啟 SSH（Mac 上：系統設定 › 通用 › 分享 › 遠端登入）。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ は UU Remote 経由のポート %2$u への接続を受け付けませんでした（%3$@）。デバイスで SSH をオンにしてください（Mac の場合:「システム設定」›「一般」›「共有」›「リモートログイン」）。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ n’a pas accepté de connexion au port %2$u via UU Remote (%3$@). Activez SSH sur l’appareil (sur un Mac : Réglages Système › Général › Partage › Session à distance)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ no ha aceptado una conexión al puerto %2$u a través de UU Remote (%3$@). Activa SSH en el dispositivo (en un Mac: Ajustes del Sistema › General › Compartir › Sesión remota)."
          }
        }
      }
    },
    "%@ from %@" : {
