    "%@ did not accept a connection to port %u through UU Remote (%@). Turn on SSH on the device (on a Mac: System Settings › General › Sharing › Remote Login)." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ did not accept a connection to port %2$u through UU Remote (%3$@). Turn on SSH on the device (on a Mac: System Settings › General › Sharing › Remote Login)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 未接受通过 UU 远程连接到端口 %u（%@）。请在该设备上开启 SSH（Mac 上：系统设置 › 通用 › 共享 › 远程登录）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 未接受通過 UU 遠端連線到埠 %u（%@）。請在該裝置上開啟 SSH（Mac 上：系統設定 › 通用 › 分享 › 遠端登入）。"
          }
        }
      }
    },
    "%@ from %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ from %2$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "来自 %2$@ 的 %1$@"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "來自 %2$@ 的 %1$@"
          }
        }
      }
    },
    "%@ is not available in this build." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此版本中不可用 %@。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此版本中不可用 %@。"
          }
        }
      }
    },
    "%@ is protected by Cloudflare Access and asks to sign in. Add a service token to the server (Edit Server › Cloudflare Access): signing in with a browser is not supported yet." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 受 Cloudflare Access 保护，要求登录。请为服务器添加服务令牌（编辑服务器 › Cloudflare Access）：目前尚不支持通过浏览器登录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 受 Cloudflare Access 保護，要求登入。請為伺服器新增服務令牌（編輯伺服器 › Cloudflare Access）：目前尚不支援通過瀏覽器登入。"
          }
        }
      }
    },
    "%@ presented a different host key than the one saved for it. Someone may be intercepting the connection. Only replace the saved key if you know the server was reinstalled or its keys were changed." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 出示的主机密钥与已存储的不同，可能有人正在拦截连接。只有在你确定服务器已重装或其密钥已更换时，才替换已存储的密钥。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 出示的主機金鑰與已儲存的不同，可能有人正在攔截連線。只有在你確定伺服器已重灌或其金鑰已更換時，才替換已儲存的金鑰。"
          }
        }
      }
    },
