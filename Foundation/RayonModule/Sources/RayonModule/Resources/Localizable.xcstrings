    "The VNC server asks for a password. Set one on the server, or on the identity it falls back to." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor VNC pide una contraseña. Configúrala en el servidor o en la identidad que usa como alternativa."
          }
