    },
    "This server could not take Ghostty's terminfo (no tic, or ~/.terminfo not writable); running as %@." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This server could not take Ghostty's terminfo (no tic, or ~/.terminfo not writable); running as %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este servidor no ha podido recibir la terminfo de Ghostty (no hay tic o ~/.terminfo no admite escritura); se ejecuta como %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce serveur n’a pas pu recevoir le terminfo de Ghostty (pas de tic, ou ~/.terminfo non accessible en écriture) : exécution en tant que %@."
