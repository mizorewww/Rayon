        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH 服务器拒绝转发到 VNC 端口 %lld（%@）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
