    "The Mac asks for a user name and password. Set the VNC user name on the server, or give it an identity." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这台 Mac 要求提供用户名和密码。请在服务器上设置 VNC 用户名，或为其指定身份。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這臺 Mac 要求提供使用者名稱和密碼。請在伺服器上設定 VNC 使用者名稱，或為其指定身份。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac がユーザ名とパスワードを求めています。サーバに VNC のユーザ名を設定するか、認証情報を指定してください。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le Mac demande un nom d’utilisateur et un mot de passe. Définissez le nom d’utilisateur VNC sur le serveur, ou attribuez-lui une identité."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El Mac pide un nombre de usuario y una contraseña. Configura el nombre de usuario VNC en el servidor o asígnale una identidad."
          }
        }
      }
    },
    "The Mac asks for a user name with the password. Set the VNC user name on the server, or give it an identity." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这台 Mac 要求在密码之外提供用户名。请在服务器上设置 VNC 用户名，或为其指定身份。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這臺 Mac 要求在密碼之外提供使用者名稱。請在伺服器上設定 VNC 使用者名稱，或為其指定身份。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac がパスワードと一緒にユーザ名を求めています。サーバに VNC のユーザ名を設定するか、認証情報を指定してください。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le Mac demande un nom d’utilisateur avec le mot de passe. Définissez le nom d’utilisateur VNC sur le serveur, ou attribuez-lui une identité."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El Mac pide un nombre de usuario junto con la contraseña. Configura el nombre de usuario VNC en el servidor o asígnale una identidad."
          }
        }
      }
    },
    "The Mac asks for the password of %@. Set one on the server, or on its identity." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这台 Mac 要求提供 %@ 的密码。请在服务器或其身份上设置密码。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這臺 Mac 要求提供 %@ 的密碼。請在伺服器或其身份上設定密碼。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac が %@ のパスワードを求めています。サーバまたはその認証情報にパスワードを設定してください。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
