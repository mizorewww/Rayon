{
  "sourceLanguage" : "en",
  "strings" : {
    "Also a daily count of which features are used. No identifier, no IP address kept." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "另外还会发送每日的功能使用计数。不保留任何标识符或 IP 地址。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "另外還會發送每日的功能使用計數。不保留任何識別符號或 IP 位址。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用された機能の日ごとの件数も送信します。識別子や IP アドレスは保持しません。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ainsi qu’un compteur quotidien des fonctions utilisées. Aucun identifiant, aucune adresse IP conservée."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "También un recuento diario de las funciones que se usan. No se guarda ningún identificador ni dirección IP."
          }
        }
      }
    },
    "Also performance timings and protocol details, on some days." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "另外还会在部分日期发送性能计时和协议详情。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "另外還會在部分日期傳送效能計時和協議詳情。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一部の日にはパフォーマンスの計測値とプロトコルの詳細も送信します。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ainsi que, certains jours, des mesures de performance et des détails de protocole."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "También tiempos de rendimiento y detalles del protocolo, algunos días."
          }
        }
      }
    },
