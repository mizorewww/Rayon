{
  "sourceLanguage" : "en",
  "strings" : {
    "Also a daily count of which features are used. No identifier, no IP address kept." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "另外还会发送每日的功能使用计数。不保留任何标识符或 IP 地址。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "另外還會發送每日的功能使用計數。不保留任何識別符號或 IP 位址。"
          }
        }
      }
    },
    "Also performance timings and protocol details, on some days." : {
