{
  "sourceLanguage" : "en",
  "strings" : {
    "NSCameraUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rayon doesn’t use the camera. A remote desktop component it includes can reach it, so iOS asks for this text; Rayon never asks for camera access."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rayon 不使用相机。它所含的远程桌面组件可以调用相机，因此 iOS 要求提供此说明；Rayon 从不请求相机权限。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rayon 不使用相機。它所含的遠端桌面元件可以呼叫相機，因此 iOS 要求提供此說明；Rayon 從不要求相機權限。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rayon はカメラを使用しません。含まれているリモートデスクトップ用コンポーネントがカメラを扱えるため iOS がこの説明を求めますが、Rayon がカメラへのアクセスを求めることはありません。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rayon n’utilise pas l’appareil photo. Un composant de bureau à distance qu’il contient peut y accéder, d’où ce texte exigé par iOS ; Rayon ne demande jamais l’accès à l’appareil photo."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rayon no usa la cámara. Un componente de escritorio remoto que incluye puede acceder a ella, por eso iOS pide este texto; Rayon nunca solicita acceso a la cámara."
          }
        }
      }
    },
    "NSFaceIDUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We are using Face ID to check your ownership of your devices before performing sensitive operation."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在执行敏感操作前，Rayon 使用面容 ID 确认你是此设备的主人。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在執行敏感操作前，Rayon 使用 Face ID 確認你是此裝置的擁有者。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重要な操作を実行する前に、Face ID を使ってデバイスの所有者であることを確認します。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rayon utilise Face ID pour vérifier que vous êtes le propriétaire de l’appareil avant toute opération sensible."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usamos Face ID para comprobar que eres el propietario de tus dispositivos antes de realizar una operación delicada."
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rayon connects to servers and screen-sharing Macs on your local network, and looks for them nearby."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rayon 会连接本地网络中的服务器和开启屏幕共享的 Mac，并在附近查找它们。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rayon 會連線區域網路中的伺服器和開啟螢幕共享的 Mac，並在附近尋找它們。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rayon はローカルネットワーク上のサーバや画面共有が有効な Mac に接続し、近くにあるものを探します。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rayon se connecte aux serveurs et aux Mac avec partage d’écran de votre réseau local, et les recherche à proximité."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rayon se conecta a servidores y a Mac con pantalla compartida de tu red local, y los busca cerca."
          }
        }
      }
    }
  },
  "version" : "1.0"
}
