        }
      }
    },
    "Rayon sends anonymous crash reports and feature counts to help fix bugs. It never sends your servers, usernames or terminal content." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rayon envía informes de fallos anónimos y recuentos de funciones para ayudar a corregir errores. Nunca envía tus servidores, nombres de usuario ni contenido del terminal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rayon envoie des rapports de plantage anonymes et des compteurs de fonctions pour corriger les bogues. Il n’envoie jamais vos serveurs, noms d’utilisateur ni contenu du terminal."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rayon はバグ修正のため、匿名のクラッシュレポートと機能の使用回数を送信します。サーバ、ユーザ名、ターミナルの内容は一切送信しません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rayon 会发送匿名崩溃报告和功能使用计数以帮助修复错误。它从不发送你的服务器、用户名或终端内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rayon 會發送匿名崩潰報告和功能使用計數以幫助修復錯誤。它從不傳送你的伺服器、使用者名稱或終端內容。"
          }
        }
      }
    },
    "Rayon telemetry reports" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Informes de telemetría de Rayon"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
