    "%@\nA user name here overrides the identity's for this server." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n此处的用户名会覆盖该身份在这台服务器上的用户名。"
