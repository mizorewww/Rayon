    "Signs in using the Mac's running SSH agent (SSH_AUTH_SOCK). iPhone and iPad have no SSH agent, so this identity signs in only from Rayon on a Mac." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicia sesión con el agente SSH en ejecución del Mac (SSH_AUTH_SOCK). El iPhone y el iPad no tienen agente SSH, así que esta identidad solo inicia sesión desde Rayon en un Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se connecte avec l’agent SSH actif du Mac (SSH_AUTH_SOCK). iPhone et iPad n’ont pas d’agent SSH : cette identité ne se connecte que depuis Rayon sur un Mac."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac で実行中の SSH エージェント（SSH_AUTH_SOCK）を使ってサインインします。iPhone と iPad には SSH エージェントがないため、この認証情報は Mac 上の Rayon からのみサインインできます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 Mac 上正在运行的 SSH 代理（SSH_AUTH_SOCK）登录。iPhone 和 iPad 没有 SSH 代理，因此此身份只能通过 Mac 上的 Rayon 登录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 Mac 上正在執行的 SSH 代理（SSH_AUTH_SOCK）登入。iPhone 和 iPad 沒有 SSH 代理，因此此身份只能通過 Mac 上的 Rayon 登入。"
          }
        }
      }
    },
    "Signs in using your Mac's running SSH agent (SSH_AUTH_SOCK), including the system ssh-agent, 1Password SSH Agent, Secretive, or YubiKey/GPG agents." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicia sesión con el agente SSH en ejecución de tu Mac (SSH_AUTH_SOCK), incluidos el ssh-agent del sistema, 1Password SSH Agent, Secretive o agentes YubiKey/GPG."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se connecte avec l’agent SSH actif de votre Mac (SSH_AUTH_SOCK), y compris le ssh-agent système, 1Password SSH Agent, Secretive ou les agents YubiKey/GPG."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac で実行中の SSH エージェント（SSH_AUTH_SOCK）を使ってサインインします。システムの ssh-agent、1Password SSH Agent、Secretive、YubiKey/GPG エージェントに対応します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用你 Mac 上正在运行的 SSH 代理（SSH_AUTH_SOCK）登录，包括系统 ssh-agent、1Password SSH Agent、Secretive 或 YubiKey/GPG 代理。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用你 Mac 上正在執行的 SSH 代理（SSH_AUTH_SOCK）登入，包括系統 ssh-agent、1Password SSH Agent、Secretive 或 YubiKey/GPG 代理。"
          }
        }
      }
    },
    "Signs the built-in UU Remote client in with QR code, SMS or an imported token." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
