    "Terminals, files, monitors and desktops you open show here, one row per server." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquí aparecen los terminales, archivos, monitores y escritorios que abras, una fila por servidor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les terminaux, fichiers, moniteurs et bureaux ouverts s’affichent ici, une ligne par serveur."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開いたターミナル、ファイル、モニタ、デスクトップがサーバごとに1行でここに表示されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你打开的终端、文件、监控和桌面会显示在这里，每台服务器一行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你開啟的終端、檔案、監控和桌面會顯示在這裡，每臺伺服器一行。"
          }
        }
      }
    },
    "That name contains characters a file name cannot have." : {
      "localizations" : {
        "es" : {
