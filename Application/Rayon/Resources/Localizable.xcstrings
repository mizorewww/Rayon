    "A server's key is saved the first time you connect; a server that later presents another key is refused. %lld saved." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "首次连接时会保存服务器的密钥；之后出示其他密钥的服务器会被拒绝。已保存 %lld 个。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "首次連線時會儲存伺服器的金鑰；之後出示其他金鑰的伺服器會被拒絕。已儲存 %lld 個。"
          }
        }
      }
    },
    "A session keeps running on the device after its tab closes, until you end it here. Resume one, or start a new one." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭标签页后，会话仍会在设备上运行，直到你在此处结束它。你可以恢复一个会话，或开始新会话。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "關閉標籤頁後，會話仍會在裝置上執行，直到你在此處結束它。你可以恢復一個會話，或開始新會話。"
          }
        }
      }
    },
