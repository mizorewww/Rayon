    "Import Host entries, IdentityFile keys, and ProxyJump links from an OpenSSH config. Pick the whole .ssh folder so the keys it names load too." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importa entradas Host, claves IdentityFile y enlaces ProxyJump de una configuración de OpenSSH. Elige toda la carpeta .ssh para que también se carguen las claves que menciona."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importer les entrées Host, les clés IdentityFile et les liens ProxyJump d’une configuration OpenSSH. Choisissez tout le dossier .ssh pour charger aussi les clés qu’elle cite."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenSSH 設定から Host エントリ、IdentityFile の鍵、ProxyJump のリンクを読み込みます。参照される鍵も読み込まれるよう、.ssh フォルダ全体を選択してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从 OpenSSH 配置中导入 Host 条目、IdentityFile 密钥和 ProxyJump 链接。请选取整个 .ssh 文件夹，以便同时载入其中引用的密钥。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "從 OpenSSH 配置中匯入 Host 條目、IdentityFile 金鑰和 ProxyJump 連結。請選取整個 .ssh 資料夾，以便同時載入其中引用的金鑰。"
          }
        }
      }
    },
