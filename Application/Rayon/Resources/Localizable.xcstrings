    "Appearance, sessions, recent servers, timeouts, monitor and terminal behavior. Font size, touch mode and the menu bar stay on each device." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apariencia, sesiones, servidores recientes, tiempos de espera, monitor y comportamiento del terminal. El tamaño de letra, el modo táctil y la barra de menús se mantienen en cada dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apparence, sessions, serveurs récents, délais, moniteur et comportement du terminal. Taille de police, mode tactile et barre des menus restent propres à chaque appareil."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "外観、セッション、最近使ったサーバ、タイムアウト、モニタ、ターミナルの動作。フォントサイズ、タッチモード、メニューバーは各デバイスに残ります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "外观、会话、最近使用的服务器、超时、监控和终端行为。字体大小、触控模式和菜单栏仅保留在各自的设备上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "外觀、會話、最近使用的伺服器、超時、監控和終端行為。字型大小、觸控模式和選單欄僅保留在各自的裝置上。"
          }
        }
      }
    },
    "Appends this identity's public key to ~/.ssh/authorized_keys on the selected servers." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade la clave pública de esta identidad a ~/.ssh/authorized_keys en los servidores seleccionados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoute la clé publique de cette identité à ~/.ssh/authorized_keys sur les serveurs sélectionnés."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この認証情報の公開鍵を、選択したサーバの ~/.ssh/authorized_keys に追加します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将此身份的公钥追加到所选服务器的 ~/.ssh/authorized_keys。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將此身份的公鑰追加到所選伺服器的 ~/.ssh/authorized_keys。"
          }
        }
      }
    },
