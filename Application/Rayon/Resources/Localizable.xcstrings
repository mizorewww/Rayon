    "Its session on %@ ends, and a new terminal to the same server opens in its place." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su sesión en %@ finaliza y se abre en su lugar un terminal nuevo al mismo servidor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sa session sur « %@ » se termine et un nouveau terminal vers le même serveur s’ouvre à sa place."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 上のセッションは終了し、同じサーバへの新しいターミナルがその場所に開きます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
