    "SSH sessions will be closed; UU Remote sessions keep running on their devices, to resume next time." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se cerrarán las sesiones SSH; las sesiones de UU Remote siguen ejecutándose en sus dispositivos para reanudarlas la próxima vez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les sessions SSH seront fermées ; les sessions UU Remote continuent sur leurs appareils, pour reprendre la prochaine fois."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH セッションは閉じられます。UU Remote のセッションはデバイス上で実行され続け、次回再開できます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH 会话将被关闭；UU 远程会话会在其设备上继续运行，以便下次恢复。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH 會話將被關閉；UU 遠端會話會在其裝置上繼續執行，以便下次恢復。"
          }
        }
      }
    },
