    "Runs a local SOCKS5 proxy on 127.0.0.1:%@ that tunnels all connections through the selected server (ssh -D)." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ejecuta un proxy SOCKS5 local en 127.0.0.1:%@ que canaliza todas las conexiones a través del servidor seleccionado (ssh -D)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lance un proxy SOCKS5 local sur 127.0.0.1:%@ qui fait passer toutes les connexions par le serveur choisi (ssh -D)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "127.0.0.1:%@ でローカル SOCKS5 プロキシを実行し、すべての接続を選択したサーバ経由でトンネルします（ssh -D）。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 127.0.0.1:%@ 上运行本地 SOCKS5 代理，通过所选服务器隧道传输所有连接（ssh -D）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 127.0.0.1:%@ 上執行本地 SOCKS5 代理，通過所選伺服器隧道傳輸所有連線（ssh -D）。"
          }
        }
      }
    },
