    "Your changes are lost if you don't save them." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus cambios se perderán si no los guardas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos modifications seront perdues si vous ne les enregistrez pas."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存しないと変更は失われます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果不存储，你的更改将丢失。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果不儲存，你的更改將丟失。"
          }
        }
      }
    },
    "Your changes are replaced by the file on the server." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus cambios se reemplazarán por el archivo del servidor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos modifications sont remplacées par le fichier du serveur."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "変更はサーバ上のファイルで置き換えられます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的更改将被服务器上的文件替换。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的更改將被伺服器上的檔案替換。"
          }
        }
      }
    },
    "Your data stays on this device. A device that still syncs will store its own again, so turn sync off there too." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus datos se quedan en este dispositivo. Un dispositivo que siga sincronizando volverá a guardar los suyos, así que desactiva también allí la sincronización."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos données restent sur cet appareil. Un appareil encore synchronisé y stockera à nouveau les siennes : désactivez aussi la synchronisation là-bas."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "データはこのデバイスに残ります。同期中のデバイスは自分のデータを再び保存するため、そちらでも同期をオフにしてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的数据会保留在这台设备上。仍在同步的设备会再次存储自己的数据，因此也请在那台设备上关闭同步。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的資料會保留在這臺裝置上。仍在同步的裝置會再次儲存自己的資料，因此也請在那臺裝置上關閉同步。"
          }
        }
      }
    },
