    "Tries each identity that authenticates automatically. A user name here overrides the identity's for this server." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prueba cada identidad con autenticación automática. Un nombre de usuario aquí reemplaza al de la identidad para este servidor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Essaie chaque identité à authentification automatique. Un nom d’utilisateur saisi ici remplace celui de l’identité pour ce serveur."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動的に認証する認証情報を順に試します。ここで指定したユーザ名は、このサーバでの認証情報のユーザ名より優先されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "依次尝试每个可自动认证的身份。此处的用户名会覆盖身份中针对此服务器的用户名。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "依次嘗試每個可自動認證的身份。此處的使用者名稱會覆蓋身份中針對此伺服器的使用者名稱。"
          }
        }
      }
    },
