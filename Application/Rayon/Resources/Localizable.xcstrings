    "Sign in to a UU Remote account to pick a device, or paste a device id / assist code below." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicia sesión en una cuenta de UU Remote para elegir un dispositivo, o pega abajo un ID de dispositivo o código de asistencia."
          }
        },
        "fr" : {
          "stringUnit" : {
