    "Keep your data the same on every device signed in to your iCloud account. Passwords and keys travel end-to-end encrypted." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén tus datos iguales en todos los dispositivos con sesión iniciada en tu cuenta de iCloud. Las contraseñas y claves viajan con cifrado de extremo a extremo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gardez les mêmes données sur tous les appareils connectés à votre compte iCloud. Mots de passe et clés sont chiffrés de bout en bout."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud アカウントにサインインしているすべてのデバイスでデータを同じに保ちます。パスワードと鍵はエンドツーエンドで暗号化されて転送されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让登录了你 iCloud 账户的所有设备上的数据保持一致。密码和密钥采用端到端加密传输。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "讓登入了你 iCloud 帳號的所有裝置上的資料保持一致。密碼和金鑰採用端到端加密傳輸。"
          }
        }
      }
    },
