    "Servers on Automatic need an identity that authenticates automatically." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los servidores en Automático necesitan una identidad con autenticación automática."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les serveurs en Automatique requièrent une identité à authentification automatique."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「自動」のサーバには、自動的に認証する認証情報が必要です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设为“自动”的服务器需要一个自动认证的身份。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設為「自動」的伺服器需要一個自動認證的身份。"
          }
        }
      }
    },
    "Servers that only accept the current key stop accepting this identity." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los servidores que solo aceptan la clave actual dejarán de aceptar esta identidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les serveurs qui n’acceptent que la clé actuelle cesseront d’accepter cette identité."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在の鍵のみを受け入れるサーバは、この認証情報を受け入れなくなります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅接受当前密钥的服务器将不再接受此身份。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "僅接受目前金鑰的伺服器將不再接受此身份。"
          }
        }
      }
    },
    "Servers, identities, snippets, port forwards, folders and known host keys in one file. With passwords and keys, the file is protected by a password." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Servidores, identidades, fragmentos, redirecciones de puertos, carpetas y claves de host conocidas en un solo archivo. Con contraseñas y claves, el archivo está protegido con contraseña."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serveurs, identités, extraits, redirections de port, dossiers et clés d’hôte connues dans un seul fichier. Avec mots de passe et clés, le fichier est protégé par un mot de passe."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバ、認証情報、スニペット、ポートフォワード、フォルダ、既知のホスト鍵を1つのファイルにまとめます。パスワードと鍵を含める場合、ファイルはパスワードで保護されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "服务器、身份、代码片段、端口转发、文件夹和已知主机密钥都在一个文件中。包含密码和密钥时，文件受密码保护。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "伺服器、身份、程式碼片段、埠轉發、資料夾和已知主機金鑰都在一個檔案中。包含密碼和金鑰時，檔案受密碼保護。"
          }
        }
      }
    },
