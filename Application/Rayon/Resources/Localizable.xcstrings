    "Merge this device's servers, identities and settings with the account signed in now, and send them to it. Or turn sync off to keep them here only." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将此设备上的服务器、身份和设置与当前登录的账户合并，并发送到该账户。或者关闭同步，仅将它们保留在此设备上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將此裝置上的伺服器、身份和設定與目前登入的帳號合併，併發送到該帳號。或者關閉同步，僅將它們保留在此裝置上。"
          }
        }
      }
