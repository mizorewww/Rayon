    "A server's key is saved the first time you connect; a server that later presents another key is refused. %lld saved." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La clave de un servidor se guarda la primera vez que te conectas; se rechaza un servidor que después presente otra clave. %lld guardadas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La clé d’un serveur est enregistrée à la première connexion ; un serveur qui présente ensuite une autre clé est refusé. %lld enregistrée(s)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバの鍵は初回接続時に保存され、後で別の鍵を提示したサーバは拒否されます。%lld 件保存済み。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "首次连接时会保存服务器的密钥；之后出示其他密钥的服务器会被拒绝。已保存 %lld 个。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "首次連線時會儲存伺服器的金鑰；之後出示其他金鑰的伺服器會被拒絕。已儲存 %lld 個。"
          }
        }
      }
    },
    "A session keeps running on the device after its tab closes, until you end it here. Resume one, or start a new one." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una sesión sigue ejecutándose en el dispositivo tras cerrar su pestaña, hasta que la finalices aquí. Reanuda una o inicia una nueva."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une session continue sur l’appareil après la fermeture de son onglet, jusqu’à ce que vous la terminiez ici. Reprenez-en une ou démarrez-en une nouvelle."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "セッションはタブを閉じてもデバイス上で実行され続け、ここで終了するまで残ります。再開するか、新しいセッションを開始してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭标签页后，会话仍会在设备上运行，直到你在此处结束它。你可以恢复一个会话，或开始新会话。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "關閉標籤頁後，會話仍會在裝置上執行，直到你在此處結束它。你可以恢復一個會話，或開始新會話。"
          }
        }
      }
    },
