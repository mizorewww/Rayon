    "Port forwards through it stop working." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las redirecciones de puertos a través de él dejan de funcionar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les redirections de port qui passent par lui cessent de fonctionner."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これを経由するポートフォワードは動作しなくなります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "经由它的端口转发将停止工作。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "經由它的埠轉發將停止工作。"
          }
        }
      }
    },
    "Port forwards through it stop working. A UU Remote device stays on your UU Remote account, which Rayon cannot remove it from; Rayon stops listing it." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las redirecciones de puertos a través de él dejan de funcionar. Un dispositivo de UU Remote permanece en tu cuenta de UU Remote, de la que Rayon no puede quitarlo; Rayon deja de mostrarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les redirections de port qui passent par lui cessent de fonctionner. Un appareil UU Remote reste sur votre compte UU Remote, dont Rayon ne peut pas le retirer ; Rayon cesse de l’afficher."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これを経由するポートフォワードは動作しなくなります。UU Remote のデバイスは UU Remote アカウントに残り、Rayon からは削除できません。Rayon に表示されなくなるだけです。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "经由它的端口转发将停止工作。UU 远程设备仍会留在你的 UU 远程账号中，Rayon 无法将其从账号移除，只会不再列出它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "經由它的連接埠轉送將停止運作。UU 遠端裝置仍會留在你的 UU 遠端帳號中，Rayon 無法將其從帳號移除，只會不再列出它。"
          }
        }
      }
    },
