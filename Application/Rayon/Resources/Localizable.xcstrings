    },
    "%@\nA user name here overrides the identity's for this server." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nUn nombre de usuario aquí reemplaza al de la identidad para este servidor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nUn nom d’utilisateur saisi ici remplace celui de l’identité pour ce serveur."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\nここで指定したユーザ名は、このサーバでの認証情報のユーザ名より優先されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n此处的用户名会覆盖该身份在这台服务器上的用户名。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n此處的使用者名稱會覆蓋該身份在這臺伺服器上的使用者名稱。"
          }
        }
      }
    },
