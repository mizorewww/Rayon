    "The file could not be read as text." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El archivo no se ha podido leer como texto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
