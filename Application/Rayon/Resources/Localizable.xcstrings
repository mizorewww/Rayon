    "Quick Connect signs in with identities set to “Authenticate automatically”. You have none yet." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conexión rápida inicia sesión con las identidades configuradas como “Autenticar automáticamente”. Aún no tienes ninguna."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La connexion rapide se connecte avec les identités réglées sur « S’authentifier automatiquement ». Vous n’en avez aucune."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クイック接続は「自動的に認証」に設定された認証情報でサインインします。まだそのような認証情報がありません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "快速连接使用设为“自动认证”的身份登录。你还没有这样的身份。"
