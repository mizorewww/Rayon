        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fond animé derrière Connexion rapide."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クイック接続の背後で動く背景。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "快速连接后面的动态背景。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "快速連線後面的動態背景。"
          }
        }
      }
    },
    "The passwords differ." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las contraseñas no coinciden."
          }
        },
